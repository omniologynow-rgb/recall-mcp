{
  "name": "recall-mcp",
  "version": "1.0.0",
  "description": "Persistent semantic memory as an MCP tool for AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "recall-mcp": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "memory",
    "semantic",
    "agent",
    "recall"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.104.0",
    "bcrypt": "^6.0.0",
    "fastify": "^5.2.2",
    "@fastify/helmet": "^13.0.2",
    "lru-cache": "^11.3.5",
    "openai": "^6.34.0",
    "pg": "^8.20.0",
    "pgvector": "^0.2.1",
    "pino": "^10.3.1",
    "supabase": "^2.93.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/pino": "^7.0.4",
    "@vitest/ui": "^4.1.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
