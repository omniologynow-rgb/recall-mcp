{
  "name": "@omniologynow/recall-mcp",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Persistent semantic memory for AI agents. Per-user partitioning, semantic recall, structured filtering, deduplication, and soft-delete with confirmation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "recall-mcp": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "validate:server-json": "node scripts/validate-server-json.js",
    "admin:create-user": "node dist/admin/create-user.js",
    "migrate": "node scripts/migrate.mjs",
    "prepublishOnly": "npm run build && npm run validate:server-json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "semantic-memory",
    "agents",
    "ai",
    "recall"
  ],
  "files": [
    "dist",
    "supabase/migrations",
    "server.json",
    "README.md",
    "LICENSE",
    "DEPLOY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omniologynow/recall-mcp.git"
  },
  "author": "OmniologyNow",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.104.0",
    "bcrypt": "^6.0.0",
    "fastify": "^5.2.2",
    "fastify-raw-body": "^5.0.0",
    "lru-cache": "^11.3.5",
    "openai": "^6.34.0",
    "pg": "^8.20.0",
    "pgvector": "^0.2.1",
    "pino": "^10.3.1",
    "raw-body": "^3.0.2",
    "stripe": "^17.7.0",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/pino": "^7.0.4",
    "@vitest/ui": "^4.1.4",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "supabase": "^2.93.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
