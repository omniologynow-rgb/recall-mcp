# Supabase Database connection (Postgres with pgvector)
# For production, use Supabase's connection string with service role key
# For local development, use `supabase start` and copy the connection string from the output
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Supabase Service Role Key (for migrations and admin operations)
# Obtain from your Supabase project settings -> API
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API key for embeddings
OPENAI_API_KEY=

# Base URL of the RecallMCP server (used for webhook callbacks)
# Example: https://recall-mcp.mcpize.app
APP_BASE_URL=http://localhost:8080

# MCPize billing webhook secret (provided by MCPize when you list your server)
MCPIZE_BILLING_WEBHOOK_SECRET=

# Optional: Port the server listens on (default 8080)
PORT=8080

# Optional: Transport mode: 'http' (default) or 'stdio' for local MCP integration
TRANSPORT=http

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: Rate limit per API key (requests per second)
RATE_LIMIT_PER_KEY=100

# Optional: Rate limit per user (requests per hour)
RATE_LIMIT_PER_USER_HOUR=10000