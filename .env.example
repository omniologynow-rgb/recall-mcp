# ── RecallMCP Environment Variables ─────────────────────────────────
# Required variables will crash the app on startup if missing.
# Optional variables gracefully disable features they control.

# ── Database (Required) ───────────────────────────────────────────
# PostgreSQL connection string. Must include the full URI including
# host, port, database name, user, and password.
# Example: postgresql://recallmcp:mypassword@postgres:5432/recallmcp
DATABASE_URL=postgresql://recallmcp:recallmcp@postgres:5432/recallmcp

# ── Server (Optional, with defaults) ──────────────────────────────
# HTTP port the app listens on. Default: 8080
PORT=8080

# Transport mode. "http" (default) for HTTP/SSE, "stdio" for MCP stdio.
# Typically only "http" is used in production.
TRANSPORT=http

# Log level. One of: trace, debug, info, warn, error, fatal. Default: info
LOG_LEVEL=info

# Node environment. Controls development-only features (DNS rebinding
# protection, etc.). Set to "production" for real deploys.
NODE_ENV=production

# ── Secrets / API Keys ────────────────────────────────────────────
# Required for embedding (at startup). Get from platform.openai.com.
# OPENAI_API_KEY=

# ── Stripe Integration (Optional — webhooks disabled when absent) ─
# Stripe secret key. Find in Stripe Dashboard → Developers → API keys.
# STRIPE_SECRET_KEY=

# Stripe webhook signing secret. Stripe Dashboard → Developers →
# Webhooks → your endpoint → Signing secret.
# STRIPE_WEBHOOK_SECRET=

# JSON mapping of Stripe price IDs to RecallMCP tiers.
# Example: {"price_abc123":"starter","price_def456":"pro","price_ghi789":"team"}
# Tiers must be one of: free, starter, pro, team
# STRIPE_PRICE_TO_TIER=

# ── MCPize Billing (Optional) ─────────────────────────────────────
# Webhook secret for MCPize.com billing integration (if used).
# MCPIZE_BILLING_WEBHOOK_SECRET=
